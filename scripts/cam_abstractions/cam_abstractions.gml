function camx(){
	var cam = view_camera[0]
	return camera_get_view_x(cam)
}
function camy(){
	var cam = view_camera[0]
	return camera_get_view_y(cam)
}
function camw(){
	var cam = view_camera[0]
	return camera_get_view_width(cam)
}
function camh(){
	var cam = view_camera[0]
	return camera_get_view_height(cam)
}
